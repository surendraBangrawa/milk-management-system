# Production Environment Variables
# Copy this file to .env.prod and update with your production values

# Database Configuration
DB_NAME=milk_management_prod
DB_USER=milk_user_prod
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here
DATABASE_URL=mysql+pymysql://milk_user_prod:your_secure_db_password_here@db:3306/milk_management_prod

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Razorpay Configuration (Production Keys)
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_SECRET_KEY=your_production_secret_key_here

# Django Configuration
DJANGO_SECRET_KEY=your_very_secure_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ip-address
STATIC_URL=https://yourdomain.com/static/
MEDIA_URL=https://yourdomain.com/media/

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# API Configuration
API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email Configuration (Production SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Timezone Configuration
TIMEZONE=Asia/Kolkata

# Subscription Configuration
TRIAL_DURATION_DAYS=30
PREMIUM_PRICE=99
PREMIUM_DURATION_DAYS=365
FREE_TIER_CUSTOMER_LIMIT=10
FREE_TIER_SUPPLIER_LIMIT=10
FREE_TIER_DAILY_TRANSACTION_LIMIT=3

# Monitoring Configuration
GRAFANA_PASSWORD=your_secure_grafana_password
PROMETHEUS_RETENTION_DAYS=30

# Security Configuration
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SSL Certificate Paths (if using custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key 