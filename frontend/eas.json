{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote"
  },
  "build": {
    "prod": {
      "distribution": "store",
      "env": {
        "APP_ENV": "production",
        "API_BASE_URL": "https://api.digidairy.site"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "dev": {
      "extends": "prod",
      "distribution": "internal",
      "env": {
        "APP_ENV": "dev",
        "API_BASE_URL": "https://api.digidairy.site"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
