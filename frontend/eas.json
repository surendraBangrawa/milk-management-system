{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "prod": {
      // This is your base production profile
      "distribution": "store",
      "env": {
        "APP_ENV": "production",
        "API_BASE_URL": "http://your-production-api-url.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "dev": {
      "extends": "prod",
      "distribution": "internal",
      "env": {
        "APP_ENV": "dev",
        "API_BASE_URL": "http://128.199.30.222:8000"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
