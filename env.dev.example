# Development Environment Variables
# Copy this file to .env.dev and update the values

# Database Configuration
DB_NAME=milk_management
DB_USER=milk_user
DB_PASSWORD=milk_password
DB_ROOT_PASSWORD=root_password
DATABASE_URL=mysql+pymysql://milk_user:milk_password@localhost:3306/milk_management

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Razorpay Configuration (Test Keys)
RAZORPAY_KEY_ID=rzp_test_demo_key_id
RAZORPAY_SECRET_KEY=demo_secret_key_change_in_production

# Django Configuration
DJANGO_SECRET_KEY=dev_django_secret_key_change_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
STATIC_URL=/static/
MEDIA_URL=/media/

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:19000

# API Configuration
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# Email Configuration (Mailhog for development)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Timezone Configuration
TIMEZONE=Asia/Kolkata

# Subscription Configuration
TRIAL_DURATION_DAYS=30
PREMIUM_PRICE=99
PREMIUM_DURATION_DAYS=365
FREE_TIER_CUSTOMER_LIMIT=10
FREE_TIER_SUPPLIER_LIMIT=10
FREE_TIER_DAILY_TRANSACTION_LIMIT=3

# Monitoring Configuration
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=7

# Security Configuration
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False 