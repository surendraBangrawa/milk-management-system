# admin/Dockerfile.prod

# Use the appropriate base image for your Django app
FROM python:3.10-slim-buster

# Set environment variables for non-interactive commands
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Define build arguments that will be passed from docker-compose.yml
ARG DB_USER
ARG DB_PASSWORD
ARG DB_HOST
ARG DB_PORT
ARG DB_NAME

# Set environment variables from build arguments
ENV DB_USER=$DB_USER
ENV DB_PASSWORD=$DB_PASSWORD
ENV DB_HOST=$DB_HOST
ENV DB_PORT=$DB_PORT
ENV DB_NAME=$DB_NAME

# Set the working directory inside the container
WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire Django project into the container
COPY . /app

# Ensure static and media directories exist and have correct permissions
# This step might be handled by collectstatic, but good to ensure for permissions
RUN mkdir -p /app/static_collected /app/media_collected && \
    chmod -R 775 /app/static_collected /app/media_collected

# The collectstatic command will now have access to the DB_* environment variables
# as they are set via ENV instructions above, which come from ARG.
# The `command` in docker-compose.yml will override this `CMD` if it's set.
# This `CMD` is here just as a placeholder if you run the container directly without compose.
CMD ["sh", "-c", "python manage.py collectstatic --noinput && python manage.py migrate && gunicorn Admin_M.wsgi:application --bind 0.0.0.0:1002"]